14:["$","div",null,{"className":"_9ugh5W_moduleDetails","children":[["$","div",null,{"children":[["$","div",null,{"className":"_9ugh5W_moduleDescription","children":"\"To north of Nispero sits the town of Desert Lotus, a small village at the border of the Akinama Desert. While the harsh weather and poor soil make the land unprosperous, the Kalimata River provides the town with water, and an ancient arcane artifact known as the “Golden Lotus” makes the ground fertile and provides the crops with nutrients allowing the town to prosper. Nevertheless, when the artifact goes missing, and crops begin to die,it will be up to a grouop of heroes to protect the town.\""}],["$","$Lb",null,{"className":"_9ugh5W_moduleLearnMoreLink","href":"/module/trouble-in-desert-lotus","children":" learn more..."}]]}],["$","button",null,{"type":"button","aria-disabled":"true","className":"_9ugh5W_moduleStatus _9ugh5W_moduleDraft","children":"Coming Soon"}]]}]
