15:[["$","title","0",{"children":"Black Cat Adventures"}],["$","meta","1",{"name":"description","content":"Black Cat Adventures, TTRPG Modules, Adventures and DMing Services!"}],["$","link","2",{"rel":"icon","href":"/favicon.ico?favicon.3l44v-zuttiiq.ico","sizes":"32x32","type":"image/x-icon"}],["$","$L17","3",{}]]
