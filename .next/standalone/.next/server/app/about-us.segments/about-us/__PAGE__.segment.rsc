12:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$1","c",{"children":[["$","main",null,{"className":"JFQvAG_pageWideWrapper","children":[["$","$La",null,{"href":"/","children":"Return to Home >"}],["$","h1",null,{"className":"JFQvAG_mainTitle","children":"About Us"}],["$","div",null,{"className":"lEw4Da_AboutUsMain","children":[["$","div",null,{"className":"lEw4Da_AboutUsImage","children":["$","$L13",null,{"src":"https://cms.blackcat-adventures.com/wp-content/uploads/2026/08/EDWIN_DM_PIC.webp","width":400,"height":400,"alt":"Edwin Broce DM Photo","preload":true}]}],["$","div",null,{"className":"lEw4Da_aboutUsDetails","children":["\n",["$","p","1",{"className":"wp-block-paragraph","children":"Hi, I’m Edwin. I’ve been a DM for 8 years and have done it professionally at events for the last two. I love creating custom adventures and storytelling. My journey started with DnD 5th Edition, DMing for my friends in a campaign I’m still running today, 8 years later. During this time, I also had Dm games DnD 5.5 edition, Dread, and Dungeon Crawler Carl. I’m currently writing my own modules, and I attend events every year where I often run seminars and DM my own adventures and pre-release Wizards of the Coast ones."}],"\n\n\n\n","$L14","\n\n\n\n","$L15","\n"]}]]}]]}],["$L16"],"$L17"]}],"p":"$@18","v":null,"s":"$e"}}]]
